generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  EMPLOYEE
  ADMIN
}

model User {
  id           String         @id
  email        String         @unique
  username     String         @unique
  studentId    String?        @unique
  employeeId   String?        @unique
  fullName     String
  avatarUrl    String?
  bio          String?
  preferences  String?        @default("{}")
  role         Role           @default(STUDENT)
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt

  tokens       RefreshToken[]
  applications UserApplicationState[]
  contacts     Contact[]
  createdJobs  JobOpportunity[]       @relation("CreatedJobs")

  @@map("users")
}

model RefreshToken {
  id                String   @id
  userId            String
  token             String   @db.Text
  isRevoked         Boolean  @default(false)
  replacedByTokenId String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  ipAddress         String?
  userAgent         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model JobOpportunity {
  id                 String   @id
  companyName        String
  companyLogo        String?
  jobTitle           String
  jobCategory        String
  companyDescription String
  companyWebsite     String
  applicationLink    String
  location           String
  workArrangement    String
  employmentType     String
  dateAdded          DateTime @default(now())
  openingDate        String?
  closingDate        String
  generalNotes       String?
  tags               String   @default("[]") // JSON string of string[]
  isShared           Boolean  @default(false)
  createdById        String?

  createdBy    User?                  @relation("CreatedJobs", fields: [createdById], references: [id], onDelete: SetNull)
  applications UserApplicationState[]

  @@map("job_opportunities")
}

model UserApplicationState {
  id                String   @id @default(uuid())
  userId            String
  opportunityId     String
  status            String
  priority          String   @default("Medium")
  dateApplied       String?
  personalNotes     String   @default("")
  followUpDate      String?
  interviewDates    String   @default("[]") // JSON array of InterviewRecord
  documentsPrepared String   @default("{}") // JSON object of DocumentChecklist
  personalLinks     String   @default("[]") // JSON array of PersonalLink
  lastUpdated       DateTime @default(now()) @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity JobOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@map("user_application_states")
}

model Contact {
  id                  String   @id @default(uuid())
  userId              String
  name                String
  company             String
  opportunityId       String?
  role                String
  email               String
  linkedIn            String
  howMet              String
  dateContacted       String
  lastInteractionDate String
  followUpDate        String?
  privateNotes        String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contacts")
}
