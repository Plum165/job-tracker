# ==============================================================================
# OPPORTUNITY HUB - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# --- Server & Runtime Environment ---
NODE_ENV="production"
PORT=3000

# --- Database Connection (PostgreSQL) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/opportunity_hub?schema=public"

# --- Enterprise JWT Authentication Secrets ---
# Must be at least 32 cryptographically secure characters long in production
JWT_ACCESS_SECRET="production_jwt_access_token_secret_key_change_me_32_chars"
JWT_REFRESH_SECRET="production_jwt_refresh_token_secret_key_change_me_32_chars"

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of allowed origins (e.g. Vercel frontend URL, custom domain)
CORS_ORIGIN="https://opportunity-hub.vercel.app,https://*.vercel.app"

# --- Frontend Environment Variables (Vite) ---
# Configured in Vercel project settings
VITE_API_BASE_URL="https://opportunity-hub-backend.onrender.com"

# --- Gemini AI Integration (Optional) ---
GEMINI_API_KEY="your_gemini_api_key_here"

# --- Platform Runtime Injection ---
APP_URL="https://opportunity-hub.vercel.app"
